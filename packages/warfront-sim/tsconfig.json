{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
