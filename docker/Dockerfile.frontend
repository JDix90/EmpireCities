# Same-origin SPA: nginx proxies /api and /socket.io to the backend (no VITE_* required).
# Build from repository root: docker build -f docker/Dockerfile.frontend .
FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/
COPY packages/shared/package.json ./packages/shared/
COPY packages/warfront-sim/package.json ./packages/warfront-sim/
RUN corepack enable && corepack prepare pnpm@10.9.0 --activate && pnpm install --frozen-lockfile
COPY frontend ./frontend
COPY packages/shared ./packages/shared
COPY packages/warfront-sim ./packages/warfront-sim
WORKDIR /app/frontend
ARG VITE_API_URL=
ARG VITE_SOCKET_URL=
ARG VITE_SENTRY_DSN=
ARG VITE_SUPPORT_EMAIL=
# Web push (Firebase Cloud Messaging). All optional: unset, the built app has
# no push UI at all. Public identifiers, not secrets — they ship in the bundle.
ARG VITE_FIREBASE_API_KEY=
ARG VITE_FIREBASE_AUTH_DOMAIN=
ARG VITE_FIREBASE_PROJECT_ID=
ARG VITE_FIREBASE_MESSAGING_SENDER_ID=
ARG VITE_FIREBASE_APP_ID=
ARG VITE_FIREBASE_VAPID_KEY=
ENV VITE_API_URL=$VITE_API_URL VITE_SOCKET_URL=$VITE_SOCKET_URL \
    VITE_SENTRY_DSN=$VITE_SENTRY_DSN VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL \
    VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN \
    VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID VITE_FIREBASE_MESSAGING_SENDER_ID=$VITE_FIREBASE_MESSAGING_SENDER_ID \
    VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID VITE_FIREBASE_VAPID_KEY=$VITE_FIREBASE_VAPID_KEY
RUN pnpm run build

FROM nginx:alpine
COPY docker/nginx.prod.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/frontend/dist /usr/share/nginx/html
