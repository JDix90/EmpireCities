require_relative '../../../node_modules/.pnpm/@capacitor+ios@6.2.2_@capacitor+core@6.2.2/node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../../node_modules/.pnpm/@capacitor+ios@6.2.2_@capacitor+core@6.2.2/node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../../node_modules/.pnpm/@capacitor+ios@6.2.2_@capacitor+core@6.2.2/node_modules/@capacitor/ios'
  pod 'AparajitaCapacitorSecureStorage', :path => '../../../node_modules/.pnpm/@aparajita+capacitor-secure-storage@6.0.1/node_modules/@aparajita/capacitor-secure-storage'
  pod 'CapacitorBrowser', :path => '../../../node_modules/.pnpm/@capacitor+browser@6.0.6_@capacitor+core@6.2.2/node_modules/@capacitor/browser'
  pod 'CapacitorHaptics', :path => '../../../node_modules/.pnpm/@capacitor+haptics@6.0.3_@capacitor+core@6.2.2/node_modules/@capacitor/haptics'
  pod 'CapacitorKeyboard', :path => '../../../node_modules/.pnpm/@capacitor+keyboard@6.0.4_@capacitor+core@6.2.2/node_modules/@capacitor/keyboard'
  pod 'CapacitorNetwork', :path => '../../../node_modules/.pnpm/@capacitor+network@6.0.4_@capacitor+core@6.2.2/node_modules/@capacitor/network'
  pod 'CapacitorPushNotifications', :path => '../../../node_modules/.pnpm/@capacitor+push-notifications@6.0.5_@capacitor+core@6.2.2/node_modules/@capacitor/push-notifications'
  pod 'CapacitorApp', :path => '../../../node_modules/.pnpm/@capacitor+app@6.0.3_@capacitor+core@6.2.2/node_modules/@capacitor/app'
  pod 'CapacitorSplashScreen', :path => '../../../node_modules/.pnpm/@capacitor+splash-screen@6.0.4_@capacitor+core@6.2.2/node_modules/@capacitor/splash-screen'
  pod 'CapacitorStatusBar', :path => '../../../node_modules/.pnpm/@capacitor+status-bar@6.0.3_@capacitor+core@6.2.2/node_modules/@capacitor/status-bar'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)
  # Current Xcode builds for iOS 15.0 and later only, and refuses a target set
  # lower. The Capacitor 6 plugins' podspecs still say 13.0, and Capacitor's
  # helper above only raises a pod to 13.0, so raise every pod to the app's
  # own minimum. `cap sync` rewrites only the capacitor_pods block, not this.
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end
end
