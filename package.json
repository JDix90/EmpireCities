{
  "name": "borderfall",
  "version": "1.0.0",
  "private": true,
  "description": "Borderfall — turn-based territory strategy across historical and galactic eras",
  "packageManager": "pnpm@10.9.0",
  "workspaces": [
    "frontend",
    "backend",
    "packages/shared",
    "packages/warfront-sim"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "db:up": "docker-compose -f docker/docker-compose.yml up -d",
    "db:down": "docker-compose -f docker/docker-compose.yml down",
    "db:migrate": "npm run migrate --workspace=backend",
    "db:seed": "npm run seed --workspace=backend",
    "seed:maps": "pnpm -C backend run seed:maps",
    "capture:maps-golden": "pnpm -C backend run capture:maps-golden",
    "verify:maps-golden": "pnpm -C backend run verify:maps-golden",
    "validate:maps": "pnpm -C backend run validate:maps",
    "test:backend": "pnpm -C backend run test",
    "test:frontend": "pnpm -C frontend exec vitest run",
    "test:warfront": "pnpm -C packages/warfront-sim run test",
    "build:warfront-terrain": "pnpm -C packages/warfront-sim run build && pnpm -C frontend run build:warfront-terrain",
    "check:secrets": "bash scripts/check-secrets.sh",
    "lint": "pnpm run lint:backend && pnpm run lint:frontend && pnpm run lint:warfront",
    "lint:backend": "pnpm exec eslint backend/src --max-warnings 0",
    "lint:frontend": "pnpm -C frontend run lint",
    "lint:warfront": "pnpm exec eslint packages/warfront-sim --max-warnings 0",
    "test:e2e:smoke": "pnpm -C frontend exec playwright test --project=chromium-smoke",
    "test:e2e:map-visual": "pnpm -C frontend exec playwright test --project=chromium-map-visual",
    "docker:prod:build": "test -f .env.production || cp .env.production.example .env.production; docker compose -f docker/docker-compose.prod.yml --env-file .env.production build",
    "docker:prod:up": "test -f .env.production || cp .env.production.example .env.production; docker compose -f docker/docker-compose.prod.yml --env-file .env.production up -d",
    "docker:prod:down": "docker compose -f docker/docker-compose.prod.yml --env-file .env.production down",
    "docker:prod:logs": "docker compose -f docker/docker-compose.prod.yml --env-file .env.production logs -f",
    "smoke:production": "bash scripts/smoke-production.sh",
    "validate:redis-staging": "bash scripts/validate-redis-staging.sh",
    "deploy:production": "bash scripts/deploy-production.sh",
    "seed:production": "bash scripts/seed-production.sh",
    "backup:databases": "bash scripts/backup-databases.sh",
    "build:android:release": "bash scripts/build-android-release.sh",
    "build:ios:release": "bash scripts/build-ios-release.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.59.0"
  }
}
